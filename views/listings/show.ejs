<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2 mt-3 mb-5">
        <h3><%=listing.title%></h3>
    </div>
    <div class="card col-8 offset-2 show-card listing-card">
        <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing image">
        <div class="card-body">
            <p class="card-text">
                Owned by <%=listing.owner.username%><br>
                <%=listing.description%><br>
                &#8377; <%=listing.price.toLocaleString("en-In")%><br>
                <%=listing.location%><br>
                <%=listing.country%><br>
            </p>
        </div>
    </div>
    <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="btns mb-3">
            <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark col-1 offset-2 edit-btn">Edit</a>
            
            <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                <button class="btn btn-dark offset-4">Delete</button>
            </form>
        </div>
    <%}%>
<hr>
    <div class="col-3 offset-2 mt-2 mb-3 btns">
        <%if(currUser) {%>
        <form method="GET" action="/listings/<%=listing._id%>/reviews">
            <button class="btn btn-outline-dark">Leave a Review</button>
        </form>
        <%}%>
    </div>
    <%if(listing.reviews.length>0) {%>
    <div class="row">
        <div class="col-10 offset-2">
            <p><b>All Reviews</b></p>

            <div class="row">
                <% for(let review of listing.reviews){ %>
                    <div class="card col-5 ms-3 mb-3">
                        <div class="card-body">
                            <h5 class="card-title">@<%=review.author.username%></h5>
                            <p class="card-text"><%= review.comment %></p>
                            <p class="starability-result" data-rating=<%= review.rating %>></p>
                            <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                                <% if(currUser && currUser._id.equals(review.author._id)) { %>
                                <div class="mb-3">
                                    <button class="btn btn-sm btn-dark">Delete</button>
                                </div>
                                <%}%>
                            </form>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
    <%}%>
   
    </div>
</div>
