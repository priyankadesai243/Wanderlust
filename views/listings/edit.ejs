<% layout("/layouts/boilerplate") %>

<form method="POST" action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
    <div class="row justify-content-center">
    <div class="col-11 col-md-10 col-lg-8">
            <br>
            <h3>Edit this Listing</h3>

            <!-- Title -->
            <div class="mb-3">
                <label class="form-label" for="title">Title</label>
                <input 
                    name="listing[title]" 
                    placeholder="Enter Title" 
                    type="text" 
                    class="form-control" 
                    value="<%=listing.title%>" 
                    required
                >
                <div class="valid-feedback">Title Looks Good</div>
                <div class="invalid-feedback">Title Should be Valid</div>
            </div>
            
            <!-- Description -->
            <div class="mb-3">
                <label class="form-label" for="description">Description</label>
                <textarea 
                    name="listing[description]" 
                    placeholder="Enter Description" 
                    class="form-control" 
                    required
                ><%=listing.description%></textarea>
                <div class="invalid-feedback">Please Enter a short description</div>
            </div>

            <!-- Current Image -->
            <div class="mb-3">
                <p><b>Original Listing Image</b></p>
                <img 
                    src="<%=originalImageUrl%>" 
                    alt="listing image"
                >
            </div>
                
            <!-- Upload New Image -->
            <div class="mb-3">
                <label class="form-label" for="image">Upload New Image</label>
                <input 
                    name="listing[image]"  
                    type="file" 
                    class="form-control"
                >
                <div class="invalid-feedback">Please upload a valid image</div>
            </div>

            <div class="mb-3">
                <label for="category" class="form-label">Category</label>
                <select name="listing[category]" class="form-select" required>
                    <option value="">Select Category</option>
                    <option value="House" <%= listing.category === "House" ? "selected" : "" %>>House</option>
                    <option value="Villa" <%= listing.category === "Villa" ? "selected" : "" %>>Villa</option>
                    <option value="Cabin" <%= listing.category === "Cabin" ? "selected" : "" %>>Cabin</option>
                    <option value="Cottage" <%= listing.category === "Cottage" ? "selected" : "" %>>Cottage</option>
                    <option value="Hotel" <%= listing.category === "Hotel" ? "selected" : "" %>>Hotel</option>
                    <option value="Beach House" <%= listing.category === "Beach House" ? "selected" : "" %>>Beach House</option>
                    <option value="Mountain Retreat" <%= listing.category === "Mountain Retreat" ? "selected" : "" %>>Mountain Retreat</option>
                    <option value="Lake View" <%= listing.category === "Lake View" ? "selected" : "" %>>Lake View</option>
                    <option value="Pools" <%= listing.category === "Pools" ? "selected" : "" %>>Pools</option>
                    <option value="Snow" <%= listing.category === "Snow" ? "selected" : "" %>>Snow</option>
                    <option value="Farm Stay" <%= listing.category === "Farm Stay" ? "selected" : "" %>>Farm Stay</option>
                    <option value="Campsite" <%= listing.category === "Campsite" ? "selected" : "" %>>Campsite</option>
                    <option value="Treehouse" <%= listing.category === "Treehouse" ? "selected" : "" %>>Treehouse</option>
                </select>
            </div>
                
            <!-- Price + Country -->
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label class="form-label" for="price">Price</label>
                    <input 
                        name="listing[price]" 
                        placeholder="Enter Price" 
                        type="number" 
                        class="form-control" 
                        value="<%=listing.price%>" 
                        required
                    >
                    <div class="invalid-feedback">Price Should be Valid</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label class="form-label" for="country">Country</label>
                    <input 
                        name="listing[country]" 
                        placeholder="Enter Country" 
                        type="text" 
                        class="form-control" 
                        value="<%=listing.country%>" 
                        required
                    >
                    <div class="invalid-feedback">Country Should be Valid</div>
                </div>
            </div>
                
            <!-- Location -->
            <div class="mb-3">
                <label class="form-label" for="location">Location</label>
                <input 
                    name="listing[location]" 
                    placeholder="Enter Location" 
                    type="text" 
                    class="form-control" 
                    value="<%=listing.location%>" 
                    required
                >
                <div class="invalid-feedback">Location Should be Valid</div>
            </div>
                
            <!-- Submit -->
           <button class="btn add-btn w-100">Update Listing</button>
            <br><br>
        </div>
    </div>
</form>